<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.earth_chat.auth.mapper.PasswordFindKeyMapper">

    <insert id="insertPasswordFindKey" parameterType="com.earth_chat.auth.vo.PasswordFindKeyVo">
        INSERT INTO password_find_key
        (
            email,
            key_value,
            use_yn,
            expired_dt,
            reg_dt,
            mod_dt
        )
        VALUES
        (
            #{email},
            #{keyValue},
            #{useYn},
            #{expiredDt},
            NOW(),
            NOW()
        )
    </insert>

</mapper>